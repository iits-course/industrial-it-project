@startuml C2-Resilience
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title C2 v0.3 · вид устойчивости — РемКонтур
caption Неделя 11 (тема 3.3). Аннотации устойчивости на внешней границе недели 8. Коды: TO тайм-аут, RT ретрай с тем же ключом, CB circuit breaker, RL rate limit, BH bulkhead, LS load shedding, DLQ dead-letter queue, HA высокая доступность, DR аварийное восстановление. Диаграмма — проектный артефакт; паттерны ещё не настроены в работающей системе.

Person(users, "Операторы, диспетчеры, инженеры", "Роли из устава §5")

System_Boundary(b, "РемКонтур — основной регион") {
    Container(arm, "АРМ сотрудника", "SPA/PWA, IndexedDB", "Формы и offline-очередь (4 ч / 500 операций). TO, CB, RT, LS")
    Container(app, "Сервис заявок", "Python, FastAPI, модульный монолит", "work-request, dispatching, access-audit. TO, RT, CB, RL, BH, LS")
    ContainerDb(db, "PostgreSQL OLTP · основной", "PostgreSQL", "Заявки, история, аудит-буфер, идемпотентность, outbox, проекция MDM. HA")
    ContainerDb(dbstandby, "PostgreSQL · синхронный standby", "PostgreSQL", "Вторая зона доступности; автоматический failover. HA")
    ContainerDb(audit, "Аудитохранилище · append-only", "Неизменяемое хранилище", "Синхронная межрегиональная копия; RPO 0. TO, RT")
    Container(auditwriter, "Аудиторский writer", "Python-воркер", "Отправляет долговременный аудит-буфер. TO, RT")
    Container(relay, "Outbox Relay", "Python-воркер", "Publisher confirm; повтор из outbox. TO, RT, CB")
    ContainerQueue(mq, "RabbitMQ", "AMQP, quorum-очереди", "Три узла в трёх зонах; at-least-once. HA, DLQ")
    Container(notifworker, "Воркер уведомлений", "Python-воркер", "Inbox, ретрай, DLQ; prefetch 20, конкурентность 4")
    Container(notifadapter, "Адаптер уведомлений · ACL", "Python-модуль", "deliver(), трансляция провайдера. TO, RT, CB, RL, BH")
    Container(analytics, "Загрузчик + хранилище аналитики + BI", "Контур OLAP", "Только чтение относительно OLTP; повтор и DLQ. RT, DLQ")
    Container(mda, "Адаптер мастер-данных · ACL", "Python-воркер", "Только чтение EAM и HR. TO, RT, CB, RL, BH")
}

System_Boundary(dr, "Регион DR · pilot light") {
    ContainerDb(drreplica, "Межрегиональная реплика PostgreSQL", "PostgreSQL", "Непрерывный WAL; повышение при объявлении. RTO 60 мин, RPO 5 мин")
    Container(driac, "Платформа pilot light", "IaC, образы, секреты", "Масштабируется при объявлении; DNS TTL 60 с")
    ContainerDb(draudit, "Неизменяемая аудиторская копия", "Object lock", "Синхронная копия; RPO 0")
}

System_Ext(sso, "Корпоративный SSO", "OIDC, стандарт: без ACL")
System_Ext(workforce, "Сервис Workforce", "Соседняя команда, workforce-v1: без ACL")
System_Ext(eam, "EAM / данные оборудования", "Legacy, внутренний")
System_Ext(hr, "HR / каталог IAM", "Legacy, внутренний")
System_Ext(provider, "Провайдер уведомлений", "Вендор или корпоративная платформа, не выбран")

Rel(users, arm, "Используют систему")
Rel(arm, app, "E1 · HTTPS: TO 10 с, RT тот же ключ ×3, CB, RL, offline-очередь")
Rel(app, db, "E2 · SQL: TO 1,5/2 с, RT только при ошибке сериализации, BH 20")
Rel(app, sso, "E3 · OIDC/JWKS: TO 2 с, RT ×2, CB, кэш ключей")
Rel(app, workforce, "E4 · REST: TO 2 с, без слепого ретрая, чтение по saga_id, CB, BH 10")
Rel(app, db, "E5 · аудит-буфер в той же транзакции")
Rel(db, auditwriter, "E12 · долговременный аудит-буфер")
Rel(auditwriter, audit, "E12 · TO 5 с, RT из буфера")
Rel(db, relay, "Чтение outbox")
Rel(relay, mq, "E6 · AMQP: confirm 5 с, RT, CB, BH")
Rel(mq, notifworker, "E7 · AMQP: ack 30 с, RT ×5, DLQ")
Rel(notifworker, notifadapter, "E8 · внутрипроцессный вызов")
Rel(notifadapter, provider, "E8 · HTTPS: TO 5 с, RT тот же ключ ×5, CB, RL, BH, DLQ")
Rel(mq, analytics, "E9 · AMQP: ack 60 с, RT ×5, DLQ")
Rel(mda, eam, "E10 · только чтение: TO 10 с, RT ×3, CB, RL, BH")
Rel(mda, hr, "E11 · только чтение: TO 10 с, RT ×3, CB, RL, BH")
Rel(mda, db, "Обновление проекции MDM")
Rel(dbstandby, drreplica, "Непрерывная репликация WAL", "асинхронная, межрегиональная")
Rel(audit, draudit, "Синхронная неизменяемая копия", "межрегиональная")
Rel(drreplica, driac, "Повышение и масштабирование при объявлении", "DR-02")

LAYOUT_TOP_DOWN()
legend right
  TO тайм-аут · RT ретрай с тем же ключом · CB circuit breaker
  RL rate limit · BH bulkhead · LS load shedding · DLQ dead-letter queue
  HA высокая доступность · DR аварийное восстановление
endlegend
@enduml
